# Optional second experiment after the CPU topology/capacity DT-only test.
# Not consumed by an existing build script. No CPU clocks or DVFS are enabled.
# SMP and GENERIC_ARCH_TOPOLOGY are already enabled in storage-v16 and suffice
# for DT capacity parsing and asymmetric-capacity detection in the PKG domain.
CONFIG_SMP=y
CONFIG_GENERIC_ARCH_TOPOLOGY=y
# These add cache/cluster scheduling domain levels; test separately from DT.
CONFIG_SCHED_MC=y
CONFIG_SCHED_CLUSTER=y
