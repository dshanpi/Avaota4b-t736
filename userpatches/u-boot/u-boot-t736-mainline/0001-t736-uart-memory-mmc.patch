diff --git a/board/t736/bringup/board.c b/board/t736/bringup/board.c
new file mode 100644
index 00000000..6d0c31c2
--- /dev/null
+++ b/board/t736/bringup/board.c
@@ -0,0 +1,75 @@
+// SPDX-License-Identifier: GPL-2.0+
+/* Independently authored from the T736 running FDT and memory evidence. */
+#include <config.h>
+#include <cpu_func.h>
+#include <init.h>
+#include <stdio.h>
+#include <linux/arm-smccc.h>
+#include <asm/global_data.h>
+#include <asm/armv8/mmu.h>
+
+DECLARE_GLOBAL_DATA_PTR;
+
+static struct mm_region t736_mem_map[] = {
+	{ .virt = 0, .phys = 0, .size = 0x40000000,
+	  .attrs = PTE_BLOCK_MEMTYPE(MT_DEVICE_NGNRNE) |
+		   PTE_BLOCK_NON_SHARE | PTE_BLOCK_PXN | PTE_BLOCK_UXN },
+	{ .virt = 0x40000000, .phys = 0x40000000, .size = 0x08000000,
+	  .attrs = PTE_BLOCK_MEMTYPE(MT_NORMAL) | PTE_BLOCK_INNER_SHARE },
+	/* Leave the observed BL31 reservation unmapped. */
+	{ .virt = 0x49000000, .phys = 0x49000000, .size = 0x69800000,
+	  .attrs = PTE_BLOCK_MEMTYPE(MT_NORMAL) | PTE_BLOCK_INNER_SHARE },
+	/* Leave the observed secure DRAM reservation unmapped. */
+	{ .virt = 0xc0000000, .phys = 0xc0000000, .size = 0x3b800000,
+	  .attrs = PTE_BLOCK_MEMTYPE(MT_NORMAL) | PTE_BLOCK_INNER_SHARE },
+	{ .virt = 0x100000000ULL, .phys = 0x100000000ULL,
+	  .size = 0x140000000ULL,
+	  .attrs = PTE_BLOCK_MEMTYPE(MT_NORMAL) | PTE_BLOCK_INNER_SHARE },
+	{ 0 }
+};
+
+struct mm_region *mem_map = t736_mem_map;
+
+int dram_init(void)
+{
+	/* No destructive sizing probe across firmware-owned memory. */
+	gd->ram_size = 0x200000000ULL;
+	return 0;
+}
+
+int dram_init_banksize(void)
+{
+	gd->dram[0].start = 0x40000000;
+	gd->dram[0].size = gd->ram_size;
+	return 0;
+}
+
+phys_addr_t board_get_usable_ram_top(phys_size_t total_size)
+{
+	/* Keep relocation below all observed high firmware reservations. */
+	return 0xb0000000;
+}
+
+int board_init(void)
+{
+	return 0;
+}
+
+int checkboard(void)
+{
+	puts("Board: T736 custom RAM bring-up; vendor DDR/BL31/SCP retained\n");
+	return 0;
+}
+
+void enable_caches(void)
+{
+	icache_enable();
+	dcache_enable();
+}
+
+void reset_cpu(void)
+{
+	struct arm_smccc_res res;
+
+	arm_smccc_smc(0x84000009, 0, 0, 0, 0, 0, 0, 0, &res);
+}
