diff --git a/arch/arm/dts/t736-bringup.dts b/arch/arm/dts/t736-bringup.dts
new file mode 100644
index 00000000..43dbb79b
--- /dev/null
+++ b/arch/arm/dts/t736-bringup.dts
@@ -0,0 +1,33 @@
+// SPDX-License-Identifier: GPL-2.0+
+/dts-v1/;
+
+/ {
+	model = "T736 custom board RAM bring-up";
+	compatible = "allwinner,t736";
+	#address-cells = <2>;
+	#size-cells = <2>;
+
+	aliases { serial0 = &uart0; };
+	chosen { stdout-path = "serial0:115200n8"; };
+
+	memory@40000000 {
+		device_type = "memory";
+		reg = <0 0x40000000 2 0>;
+	};
+
+	mmc@4023000 {
+		compatible = "allwinner,t736-smhc3-bringup";
+		reg = <0 0x04023000 0 0x1000>;
+		bus-width = <8>;
+		non-removable;
+	};
+
+	uart0: serial@2500000 {
+		compatible = "snps,dw-apb-uart";
+		reg = <0 0x02500000 0 0x400>;
+		reg-shift = <2>;
+		reg-io-width = <4>;
+		clock-frequency = <24000000>;
+		bootph-all;
+	};
+};
