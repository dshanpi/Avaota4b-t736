diff --git a/drivers/mmc/t736_mmc.c b/drivers/mmc/t736_mmc.c
new file mode 100644
index 00000000..c9ef8b72
--- /dev/null
+++ b/drivers/mmc/t736_mmc.c
@@ -0,0 +1,219 @@
+// SPDX-License-Identifier: GPL-2.0+
+/* T736 SMHC3: documented registers, read-only PIO and inherited power rails. */
+#include <dm.h>
+#include <mmc.h>
+#include <asm/io.h>
+#include <linux/delay.h>
+#include <linux/errno.h>
+#include <linux/iopoll.h>
+
+#define CTRL 0x00
+#define CLKDIV 0x04
+#define TIMEOUT 0x08
+#define WIDTH 0x0c
+#define BLOCKSIZE 0x10
+#define BYTECOUNT 0x14
+#define COMMAND 0x18
+#define ARGUMENT 0x1c
+#define RESPONSE 0x20
+#define IRQMASK 0x30
+#define IRQSTATUS 0x38
+#define STATUS 0x3c
+#define TIMING 0x5c
+#define CARDRESET 0x78
+#define FIFO 0x200
+#define CMD_START BIT(31)
+#define IRQ_ERRORS 0xbfc2
+
+struct t736_mmc {
+	void __iomem *base;
+	struct mmc_config cfg;
+	struct mmc mmc;
+};
+
+static int update_clock(struct t736_mmc *p)
+{
+	u32 value;
+	int ret;
+
+	writel(CMD_START | BIT(21) | BIT(13), p->base + COMMAND);
+	ret = readl_poll_timeout(p->base + COMMAND, value,
+				!(value & CMD_START), 1000000);
+	writel(~0U, p->base + IRQSTATUS);
+	return ret;
+}
+
+static int t736_set_ios(struct udevice *dev)
+{
+	struct t736_mmc *p = dev_get_plat(dev);
+	unsigned int divisor;
+	int ret;
+
+	writel(BIT(31), p->base + CLKDIV);
+	ret = update_clock(p);
+	if (ret || !p->mmc.clock)
+		return ret;
+	/* New timing mode divides the module clock by two. */
+	divisor = DIV_ROUND_UP(24000000U, 2 * p->mmc.clock);
+	if (!divisor || divisor > 32)
+		return -EINVAL;
+	writel(BIT(31) | (divisor - 1), (void __iomem *)0x02002d30);
+	setbits_le32(p->base + TIMING, BIT(31));
+	writel(p->mmc.bus_width == 8 ? 2 : p->mmc.bus_width == 4 ? 1 : 0,
+	       p->base + WIDTH);
+	writel(BIT(31) | BIT(16), p->base + CLKDIV);
+	ret = update_clock(p);
+	clrbits_le32(p->base + CLKDIV, BIT(31));
+	return ret;
+}
+
+static int t736_send_cmd(struct udevice *dev, struct mmc_cmd *cmd,
+			 struct mmc_data *data)
+{
+	struct t736_mmc *p = dev_get_plat(dev);
+	u32 flags = CMD_START | cmd->cmdidx, status, value;
+	unsigned long start;
+	unsigned int remaining = 0;
+	u8 *dest = NULL;
+	int i, ret;
+
+	if (cmd->cmdidx == 24 || cmd->cmdidx == 25 || cmd->cmdidx == 38 ||
+	    (data && (data->flags & MMC_DATA_WRITE)))
+		return -EROFS;
+	if (data) {
+		if (data->blocks != 1 || (data->blocksize & 3))
+			return -EINVAL;
+		remaining = data->blocksize;
+		dest = (u8 *)data->dest;
+		setbits_le32(p->base + CTRL, BIT(1));
+		ret = readl_poll_timeout(p->base + CTRL, value,
+					!(value & BIT(1)), 100000);
+		if (ret)
+			return ret;
+		writel(data->blocksize, p->base + BLOCKSIZE);
+		writel(remaining, p->base + BYTECOUNT);
+		flags |= BIT(9) | BIT(13);
+	}
+	if (!cmd->cmdidx)
+		flags |= BIT(15);
+	if (cmd->resp_type & MMC_RSP_PRESENT)
+		flags |= BIT(6);
+	if (cmd->resp_type & MMC_RSP_136)
+		flags |= BIT(7);
+	if (cmd->resp_type & MMC_RSP_CRC)
+		flags |= BIT(8);
+	writel(~0U, p->base + IRQSTATUS);
+	writel(cmd->cmdarg, p->base + ARGUMENT);
+	writel(flags, p->base + COMMAND);
+	start = get_timer(0);
+	for (;;) {
+		status = readl(p->base + IRQSTATUS);
+		if (status & IRQ_ERRORS) {
+			debug("T736 CMD%u status=%08x\n", cmd->cmdidx, status);
+			return status & (BIT(8) | BIT(9)) ? -ETIMEDOUT : -EIO;
+		}
+		if (remaining && !(readl(p->base + STATUS) & BIT(2))) {
+			value = readl(p->base + FIFO);
+			memcpy(dest, &value, sizeof(value));
+			dest += sizeof(value);
+			remaining -= sizeof(value);
+		}
+		if (!remaining && (status & BIT(2)) && (!data || (status & BIT(3))))
+			break;
+		if (get_timer(start) > 2000)
+			return -ETIMEDOUT;
+	}
+	if (cmd->resp_type & MMC_RSP_136)
+		for (i = 0; i < 4; i++)
+			cmd->response[i] = readl(p->base + RESPONSE + (3 - i) * 4);
+	else
+		cmd->response[0] = readl(p->base + RESPONSE);
+	if (cmd->resp_type & MMC_RSP_BUSY) {
+		ret = readl_poll_timeout(p->base + STATUS, value,
+					!(value & BIT(9)), 2000000);
+		if (ret)
+			return ret;
+	}
+	writel(~0U, p->base + IRQSTATUS);
+	return 0;
+}
+
+static int t736_get_cd(struct udevice *dev)
+{
+	return 1;
+}
+
+static int t736_probe(struct udevice *dev)
+{
+	static const u8 pins[] = { 0, 1, 5, 6, 8, 9, 10, 11, 13, 14, 15, 16 };
+	struct t736_mmc *p = dev_get_plat(dev);
+	struct mmc_uclass_priv *upriv = dev_get_uclass_priv(dev);
+	void __iomem *reg;
+	u32 value;
+	int i, ret;
+
+	p->base = dev_read_addr_ptr(dev);
+	if (!p->base)
+		return -EINVAL;
+	/* Function 4 selects SMHC3; prior firmware sets rails and pad drive. */
+	for (i = 0; i < ARRAY_SIZE(pins); i++) {
+		reg = (void __iomem *)(0x02000180UL + (pins[i] / 8) * 4);
+		clrsetbits_le32(reg, 0xf << ((pins[i] % 8) * 4),
+			       4 << ((pins[i] % 8) * 4));
+	}
+	writel(BIT(31), (void __iomem *)0x02002d30);
+	clrbits_le32((void __iomem *)0x02002d3c, BIT(16));
+	udelay(10);
+	setbits_le32((void __iomem *)0x02002d3c, BIT(16) | BIT(0));
+	writel(7, p->base + CTRL);
+	ret = readl_poll_timeout(p->base + CTRL, value, !(value & 7), 100000);
+	if (ret)
+		return ret;
+	writel(BIT(31), p->base + CTRL);
+	writel(0, p->base + IRQMASK);
+	writel(~0U, p->base + IRQSTATUS);
+	writel(~0U, p->base + TIMEOUT);
+	writel(0, p->base + CARDRESET);
+	udelay(10);
+	writel(1, p->base + CARDRESET);
+	mdelay(1);
+	p->cfg.name = "T736 SMHC3 read-only PIO";
+	p->cfg.host_caps = MMC_MODE_4BIT | MMC_MODE_8BIT;
+	p->cfg.voltages = MMC_VDD_32_33 | MMC_VDD_33_34;
+	p->cfg.f_min = 400000;
+	p->cfg.f_max = 12000000;
+	p->cfg.b_max = 1;
+	p->mmc.cfg = &p->cfg;
+	p->mmc.dev = dev;
+	p->mmc.priv = p;
+	upriv->mmc = &p->mmc;
+	return 0;
+}
+
+static int t736_bind(struct udevice *dev)
+{
+	struct t736_mmc *p = dev_get_plat(dev);
+
+	return mmc_bind(dev, &p->mmc, &p->cfg);
+}
+
+static const struct dm_mmc_ops t736_ops = {
+	.send_cmd = t736_send_cmd,
+	.set_ios = t736_set_ios,
+	.get_cd = t736_get_cd,
+};
+
+static const struct udevice_id t736_ids[] = {
+	{ .compatible = "allwinner,t736-smhc3-bringup" },
+	{ }
+};
+
+U_BOOT_DRIVER(t736_mmc) = {
+	.name = "t736_mmc",
+	.id = UCLASS_MMC,
+	.of_match = t736_ids,
+	.ops = &t736_ops,
+	.bind = t736_bind,
+	.probe = t736_probe,
+	.plat_auto = sizeof(struct t736_mmc),
+};
