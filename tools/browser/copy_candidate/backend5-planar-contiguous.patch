+/* Called only after copy_sample validated crop, strides and plane spans. */
+static void copy_planar_plane(uint8_t *destination, const uint8_t *source,
+                              unsigned row_bytes, unsigned rows, int stride)
+{
+    if ((unsigned)stride == row_bytes)
+        memcpy(destination, source, (size_t)row_bytes * rows);
+    else
+        for (unsigned row = 0; row < rows; row++)
+            memcpy(destination + (size_t)row * row_bytes,
+                   source + (size_t)row * (unsigned)stride, row_bytes);
 }
 
