#!/bin/sh
# Launches a private-profile candidate. The regular desktop Firefox is untouched.
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
export T736_CEDAR_ENABLE=1
export LD_LIBRARY_PATH="$root/lib/ffmpeg:$root/lib:/opt/t736-img-ddk-24.2-x11/runtime-gles${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export LIBGL_DRIVERS_PATH="${LIBGL_DRIVERS_PATH:-/opt/t736-img-ddk-24.2-x11/lib/dri}"
export MOZ_X11_EGL=1
export LD_PRELOAD="$root/lib/libt736_cedar_client.so:$root/lib/ffmpeg/libavutil.so.59:$root/lib/ffmpeg/libavcodec.so.61${LD_PRELOAD:+:$LD_PRELOAD}"
unset T736_CEDAR_TEST_CLIENT
exec /usr/lib/firefox-esr/firefox-esr "$@"
