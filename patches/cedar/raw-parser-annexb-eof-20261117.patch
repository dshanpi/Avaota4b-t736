+/* Bounded Annex-B scan; accept both three- and four-byte prefixes. */
+static int find_annexb_start(const unsigned char *p, int length, int from, int *prefix)
+{
+    for (int i = from; i + 3 <= length; ++i) {
+        if (p[i] || p[i + 1])
+            continue;
+        if (p[i + 2] == 1) {
+            *prefix = 3;
+            return i;
+        }
+        if (i + 4 <= length && p[i + 2] == 0 && p[i + 3] == 1) {
+            *prefix = 4;
+            return i;
+        }
+    }
+    return -1;
+}
