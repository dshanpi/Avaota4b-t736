+/* SBC confirms completion of a buffer swap, including a copy. It does not
+ * identify a scanout timestamp. In particular, never copy the latest UST
+ * into the current frame's presentation_time_us. */
+static void
+trace_sbc_summary (CoglOnscreenXlib *onscreen_xlib,
+                   const char       *reason,
+                   gboolean          final)
+{
+  if (g_strcmp0 (g_getenv ("COGL_EGL_X11_SBC_TRACE"), "1") != 0 ||
+      !onscreen_xlib->sbc_attempted ||
+      (!final && onscreen_xlib->sbc_trace_count >= 8))
+    return;
+  onscreen_xlib->sbc_trace_count++;
+  g_message ("EGL_X11_SBC surface=%lu reason=%s disabled=%d "
+             "submitted=%" G_GUINT64_FORMAT " submit_failures=%" G_GUINT64_FORMAT
+             " confirmed=%" G_GUINT64_FORMAT " symbolic=%" G_GUINT64_FORMAT
+             " max_wait_us=%" G_GINT64_FORMAT " max_queue_depth=%u",
+             onscreen_xlib->xwin, reason, onscreen_xlib->sbc_failed,
+             onscreen_xlib->sbc_submissions, onscreen_xlib->sbc_submit_failures,
+             onscreen_xlib->sbc_confirmed, onscreen_xlib->sbc_symbolic,
+             onscreen_xlib->sbc_max_wait_us, onscreen_xlib->sbc_max_queue_depth);
+}
+
+static gboolean
+query_sbc (CoglOnscreenXlib *onscreen_xlib,
+           int64_t          *sbc)
+{
+  CoglFramebuffer *framebuffer = COGL_FRAMEBUFFER (onscreen_xlib);
+  CoglContext *context = cogl_framebuffer_get_context (framebuffer);
+  CoglRendererEGL *egl_renderer = context->display->renderer->winsys;
+  EGLSurface surface =
+    cogl_onscreen_egl_get_egl_surface (COGL_ONSCREEN_EGL (onscreen_xlib));
+  int64_t ust, msc;
+
+  /* The extension requires a current EGL context. Keep Cogl's bind cache
+   * coherent rather than making an untracked eglMakeCurrent call. */
+  cogl_context_flush_framebuffer_state (context, framebuffer, framebuffer,
+                                        COGL_FRAMEBUFFER_STATE_BIND);
+  return egl_renderer->pf_eglGetSyncValues (egl_renderer->edpy,
+                                                   surface, &ust, &msc, sbc);
+}
+
+static gboolean
+finish_sbc_head (CoglOnscreenXlib *onscreen_xlib,
+                 gboolean          confirmed)
+{
+  CoglOnscreen *onscreen = COGL_ONSCREEN (onscreen_xlib);
+  g_autofree SbcPendingFrame *pending =
+    g_queue_pop_head (&onscreen_xlib->sbc_pending);
+  g_autoptr (CoglFrameInfo) info = cogl_onscreen_pop_head_frame_info (onscreen);
+
+  gboolean identity_ok;
+
+  g_return_val_if_fail (pending != NULL, FALSE);
+  g_return_val_if_fail (info != NULL, FALSE);
+  identity_ok = info->frame_counter == pending->frame_counter;
+  confirmed = confirmed && pending->buffer_swap;
+  if (!identity_ok)
+    {
+      g_warning ("EGL X11 SBC frame queue identity mismatch");
+      confirmed = FALSE;
+      onscreen_xlib->sbc_failed = TRUE;
+    }
+
+  info->presentation_time_us = 0;
+  info->refresh_rate = confirmed ? onscreen_xlib->sbc_refresh_rate : 0;
+  info->flags &= ~(COGL_FRAME_INFO_FLAG_HW_CLOCK |
+                   COGL_FRAME_INFO_FLAG_VSYNC |
+                   COGL_FRAME_INFO_FLAG_ZERO_COPY);
+  if (!confirmed)
+    info->flags |= COGL_FRAME_INFO_FLAG_SYMBOLIC;
+
+  if (confirmed)
+    onscreen_xlib->sbc_confirmed++;
+  else
+    onscreen_xlib->sbc_symbolic++;
+  onscreen_xlib->sbc_max_wait_us =
+    MAX (onscreen_xlib->sbc_max_wait_us,
+         g_get_monotonic_time () - pending->submitted_at_us);
+  if ((onscreen_xlib->sbc_confirmed + onscreen_xlib->sbc_symbolic) % 120 == 0)
+    trace_sbc_summary (onscreen_xlib, "periodic", FALSE);
+
+  _cogl_onscreen_queue_event (onscreen, COGL_FRAME_EVENT_SYNC, info);
+  _cogl_onscreen_queue_event (onscreen, COGL_FRAME_EVENT_COMPLETE, info);
+  return identity_ok;
+}
+
+static void
+fail_sbc_tracking (CoglOnscreenXlib *onscreen_xlib,
+                   const char       *reason)
+{
+  if (!onscreen_xlib->sbc_failed)
+    g_warning ("EGL X11 SBC feedback disabled for this surface: %s", reason);
+  onscreen_xlib->sbc_failed = TRUE;
+  while (!g_queue_is_empty (&onscreen_xlib->sbc_pending))
+    finish_sbc_head (onscreen_xlib, FALSE);
+  trace_sbc_summary (onscreen_xlib, reason, FALSE);
+}
+
+static gboolean
+query_sbc_rate (CoglOnscreenXlib *onscreen_xlib)
+{
+  CoglContext *context =
+    cogl_framebuffer_get_context (COGL_FRAMEBUFFER (onscreen_xlib));
+  CoglRendererEGL *egl_renderer = context->display->renderer->winsys;
+  EGLSurface surface =
+    cogl_onscreen_egl_get_egl_surface (COGL_ONSCREEN_EGL (onscreen_xlib));
+  gint32 numerator = 0, denominator = 0;
+
+  onscreen_xlib->sbc_refresh_rate = 0;
+  if (!egl_renderer->pf_eglGetMscRate (egl_renderer->edpy, surface,
+                                           &numerator, &denominator) ||
+      numerator <= 0 || denominator <= 0 ||
+      (double) numerator / denominator > 1000)
+    return FALSE;
+  onscreen_xlib->sbc_refresh_rate = (float) numerator / denominator;
+  return TRUE;
+}
+
+static gboolean
+poll_sbc (gpointer user_data)
+{
+  CoglOnscreenXlib *onscreen_xlib = user_data;
+  SbcPendingFrame *pending;
+  int64_t sbc;
+
+  if (g_queue_is_empty (&onscreen_xlib->sbc_pending))
+    {
+      onscreen_xlib->sbc_poll_source = 0;
+      return G_SOURCE_REMOVE;
+    }
+  if (!query_sbc (onscreen_xlib, &sbc))
+    fail_sbc_tracking (onscreen_xlib, "sync query failed");
+  else if (sbc < onscreen_xlib->completed_sbc ||
+           sbc > onscreen_xlib->submitted_sbc)
+    fail_sbc_tracking (onscreen_xlib, "counter reset or out-of-range completion");
+  else
+    {
+      onscreen_xlib->completed_sbc = sbc;
+      pending = g_queue_peek_head (&onscreen_xlib->sbc_pending);
+      if (pending && pending->target_sbc <= sbc)
+        query_sbc_rate (onscreen_xlib);
+      while ((pending = g_queue_peek_head (&onscreen_xlib->sbc_pending)) &&
+             pending->target_sbc <= sbc)
+        {
+          if (!finish_sbc_head (onscreen_xlib, TRUE))
+            {
+              fail_sbc_tracking (onscreen_xlib, "frame queue identity mismatch");
+              break;
+            }
+        }
+      pending = g_queue_peek_head (&onscreen_xlib->sbc_pending);
+      if (pending && g_get_monotonic_time () >= pending->deadline_us)
+        fail_sbc_tracking (onscreen_xlib, "250ms completion deadline exceeded");
+    }
+
+  if (g_queue_is_empty (&onscreen_xlib->sbc_pending))
+    {
+      onscreen_xlib->sbc_poll_source = 0;
+      return G_SOURCE_REMOVE;
+    }
+  return G_SOURCE_CONTINUE;
+}
+
+static void
+start_sbc_tracking (CoglOnscreenXlib *onscreen_xlib)
+{
+  int64_t baseline;
+
+  if (onscreen_xlib->sbc_attempted)
+    return;
+  onscreen_xlib->sbc_attempted = TRUE;
+  if (!query_sbc (onscreen_xlib, &baseline) || baseline < 0 ||
+      !query_sbc_rate (onscreen_xlib))
+    {
+      fail_sbc_tracking (onscreen_xlib, "initial counter/rate query failed");
+      return;
+    }
+  onscreen_xlib->submitted_sbc = baseline;
+  onscreen_xlib->completed_sbc = baseline;
+  trace_sbc_summary (onscreen_xlib, "enabled", FALSE);
+}
+
+static void
+queue_sbc_frame (CoglOnscreenXlib *onscreen_xlib,
+                 CoglFrameInfo    *info,
+                 gboolean          buffer_swap)
+{
+  SbcPendingFrame *pending = g_new0 (SbcPendingFrame, 1);
+
+  pending->frame_counter = info->frame_counter;
+  pending->submitted_at_us = g_get_monotonic_time ();
+  pending->deadline_us = pending->submitted_at_us + 250000;
+  pending->buffer_swap = buffer_swap;
+  if (!onscreen_xlib->sbc_failed)
+    {
+      if (buffer_swap)
+        {
+          if (onscreen_xlib->submitted_sbc == G_MAXINT64)
+            {
+              /* Include this newly queued Cogl frame in the symbolic drain. */
+              g_queue_push_tail (&onscreen_xlib->sbc_pending, pending);
+              fail_sbc_tracking (onscreen_xlib, "counter overflow");
+              return;
+            }
+          onscreen_xlib->submitted_sbc++;
+        }
+      pending->target_sbc = onscreen_xlib->submitted_sbc;
+    }
+  g_queue_push_tail (&onscreen_xlib->sbc_pending, pending);
+  onscreen_xlib->sbc_max_queue_depth =
+    MAX (onscreen_xlib->sbc_max_queue_depth,
+         g_queue_get_length (&onscreen_xlib->sbc_pending));
+
+  if (onscreen_xlib->sbc_failed ||
+      g_queue_get_length (&onscreen_xlib->sbc_pending) > 16)
+    {
+      fail_sbc_tracking (onscreen_xlib, "pending queue limit or disabled tracker");
+      return;
+    }
+
+  if (!onscreen_xlib->sbc_poll_source)
+    {
+      onscreen_xlib->sbc_poll_source =
+        g_timeout_add (2, poll_sbc, onscreen_xlib);
+      g_source_set_name_by_id (onscreen_xlib->sbc_poll_source,
+                              "[cogl] EGL X11 SBC completion");
+    }
+}
+
+static void
+cogl_onscreen_xlib_swap_buffers_with_damage (CoglOnscreen    *onscreen,
+                                             const MtkRegion *region,
+                                             CoglFrameInfo   *info,
+                                             gpointer         user_data)
+{
+  CoglOnscreenXlib *onscreen_xlib = COGL_ONSCREEN_XLIB (onscreen);
+  CoglContext *context =
+    cogl_framebuffer_get_context (COGL_FRAMEBUFFER (onscreen));
+  CoglOnscreenClass *parent_class =
+    COGL_ONSCREEN_CLASS (cogl_onscreen_xlib_parent_class);
+  gboolean use_sbc = cogl_context_has_winsys_feature (
+    context, COGL_WINSYS_FEATURE_SYNC_AND_COMPLETE_EVENT);
+
+  if (!use_sbc)
+    {
+      parent_class->swap_buffers_with_damage (onscreen, region, info, user_data);
+      return;
+    }
+
+  start_sbc_tracking (onscreen_xlib);
+  if (cogl_onscreen_egl_swap_buffers_with_damage_checked (onscreen, region,
+                                                           info, user_data))
+    onscreen_xlib->sbc_submissions++;
+  else
+    {
+      onscreen_xlib->sbc_submit_failures++;
+      fail_sbc_tracking (onscreen_xlib, "EGL swap submission failed");
+    }
+  queue_sbc_frame (onscreen_xlib, info, TRUE);
+}
+
+static void
+cogl_onscreen_xlib_swap_region (CoglOnscreen    *onscreen,
+                                const MtkRegion *region,
+                                CoglFrameInfo   *info,
+                                gpointer         user_data)
+{
+  CoglOnscreenXlib *onscreen_xlib = COGL_ONSCREEN_XLIB (onscreen);
+  CoglContext *context =
+    cogl_framebuffer_get_context (COGL_FRAMEBUFFER (onscreen));
+  CoglOnscreenClass *parent_class =
+    COGL_ONSCREEN_CLASS (cogl_onscreen_xlib_parent_class);
+  gboolean use_sbc = cogl_context_has_winsys_feature (
+    context, COGL_WINSYS_FEATURE_SYNC_AND_COMPLETE_EVENT);
+
+  if (use_sbc)
+    {
+      start_sbc_tracking (onscreen_xlib);
+      fail_sbc_tracking (onscreen_xlib, "explicit swap_region bypasses SBC accounting");
+    }
+  parent_class->swap_region (onscreen, region, info, user_data);
+  /* Normally unreachable because SWAP_REGION is disabled in this mode.
+   * Explicit callers still get symbolic notifications, in queue order,
+   * without inventing an SBC increment for a PostSubBuffer operation. */
+  if (use_sbc)
+    queue_sbc_frame (onscreen_xlib, info, FALSE);
+}
