printf 'INDEPENDENT_BOOT_MEDIA_AUDIT\n'; uname -a; id; ls -l /dev/mmcblk0*; command -v mmc || true; for p in /sys/block/mmcblk0boot*/size /sys/block/mmcblk0boot*/force_ro; do printf '%s: ' "$p"; cat "$p"; done; for p in /dev/mmcblk0boot0 /dev/mmcblk0boot1; do printf '%s first sector: ' "$p"; dd if="$p" bs=512 count=1 status=none | od -An -tx1 -N48; done

