echo BROWSER_MEDIA_STATE; dpkg-query -W -f='${binary:Package} ${Version}\n' firefox-esr libavcodec61 libva2 2>/dev/null; ps -eo pid,ppid,psr,pcpu,comm,args | grep -E 'firefox|RDD Process|Web Content' | head -n 18; for p in $(pgrep -u t736 -f '/usr/lib/firefox-esr/firefox-esr'); do echo FIREFOX_PID=$p; tr '\0' '\n' </proc/$p/environ | grep -E '^(LD_LIBRARY_PATH=|LIBGL|GALLIUM|MESA|GDK|MOZ_|DISPLAY=|XDG_SESSION_TYPE=)'; grep -E 'libEGL|libGLES|libGLX|libGL\.so|pvr|swrast|gallium|libva|libavcodec|libvpx|libdav1d' /proc/$p/maps | awk '{print $NF}' | sort -u; done; ls -l /dev/dri /dev/video* /dev/cedar* /dev/ve* 2>/dev/null; echo BROWSER_MEDIA_STATE_DONE

